{
  "name": "elyon-seller-tool",
  "private": true,
  "type": "module",
  "scripts": {
    "check:layout": "node scripts/check-layout.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "prepare:web": "npm run check:layout && node scripts/prepare-vercel.mjs",
    "start": "node scripts/dev-server.mjs",
    "dev": "npm run start",
    "launcher": "electron launcher/main.cjs",
    "launcher:terminal": "node scripts/elyon-launcher.mjs",
    "build": "npm test && npm run prepare:web",
    "test": "node --test tests/*.test.mjs",
    "test:vercel": "node scripts/run-vercel-tests.mjs"
  },
  "dependencies": {
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0"
  }
}

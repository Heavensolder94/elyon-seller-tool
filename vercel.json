{
  "buildCommand": "node scripts/prepare-vercel.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/ebay-callback",
      "destination": "/ebay-accepted.html"
    },
    {
      "source": "/ebay-callback/",
      "destination": "/ebay-accepted.html"
    },
    {
      "source": "/ebay-login",
      "destination": "/api/ebay/login-url"
    },
    {
      "source": "/api/ebay/login-url",
      "destination": "/api/ebay?action=login-url"
    },
    {
      "source": "/api/ebay/status",
      "destination": "/api/ebay?action=status"
    },
    {
      "source": "/api/ebay/search",
      "destination": "/api/ebay?action=search"
    },
    {
      "source": "/api/ebay/competition",
      "destination": "/api/ebay?action=competition"
    },
    {
      "source": "/api/ebay/exchange-token",
      "destination": "/api/ebay?action=exchange-token"
    },
    {
      "source": "/api/ebay/token",
      "destination": "/api/ebay?action=token"
    },
    {
      "source": "/api/ping",
      "destination": "/api/health"
    },
    {
      "source": "/api/google-drive/oauth/start",
      "destination": "/api/google-drive/oauth/start"
    },
    {
      "source": "/api/google-drive/oauth/start/",
      "destination": "/api/google-drive/oauth/start"
    },
    {
      "source": "/api/google-drive/oauth/callback",
      "destination": "/api/google-drive/oauth/callback"
    },
    {
      "source": "/api/google-drive/oauth/callback/",
      "destination": "/api/google-drive/oauth/callback"
    },
    {
      "source": "/ebay-token-exchange",
      "destination": "/ebay-token-exchange/index.html"
    },
    {
      "source": "/ebay-token-exchange/",
      "destination": "/ebay-token-exchange/index.html"
    }
  ]
}

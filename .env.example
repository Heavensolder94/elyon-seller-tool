# Elyon Seller Tool - ENV Vorlage
# Kopiere diese Datei lokal zu .env.local und trage dort deine echten Werte ein.
# WICHTIG: Keine echten API-Keys in GitHub committen.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://127.0.0.1:4173/ebay-callback
EBAY_RUNAME=
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_REFRESH_TOKEN=

CJ_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/google-drive/oauth/callback
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

GOOGLE_SHEETS_SYNC_URL=
GOOGLE_SHEETS_SYNC_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_FLASH_MODEL=qwen-flash
QWEN_MAX_MODEL=qwen-max

FEATURE_FLAGS_ADMIN_TOKEN=

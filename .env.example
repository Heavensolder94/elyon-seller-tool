# Elyon Seller Tool - ENV Vorlage
# Kopiere diese Datei lokal zu .env.local und trage dort deine echten Werte ein.
# WICHTIG: Keine echten API-Keys in GitHub committen.

# Browser-Login für das Seller Tool
ELYON_SELLER_ACCESS_TOKEN=
# Interne serverseitige Brücke vom Company OS. Nicht in Browser/Extension eintragen.
ELYON_BRIDGE_SECRET=
CRON_SECRET=
FEATURE_FLAGS_ADMIN_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Jarvis E4 Kostenkontrolle.
# Trage hier die für deine tatsächlich verwendeten Provider/Modelle geltenden EUR-Kosten pro 1 Mio. Tokens ein.
# Die Werte bleiben bewusst leer, damit veraltete Providerpreise nicht im Code fest verdrahtet werden.
# Solange für einen aktiven externen Provider eine Rate fehlt, pausiert E4 autonome KI-Ausführung fail-closed.
ELYON_AI_OPENAI_INPUT_EUR_PER_1M=
ELYON_AI_OPENAI_OUTPUT_EUR_PER_1M=
ELYON_AI_DEEPSEEK_INPUT_EUR_PER_1M=
ELYON_AI_DEEPSEEK_OUTPUT_EUR_PER_1M=

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://127.0.0.1:4173/ebay-callback
EBAY_RUNAME=
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_REFRESH_TOKEN=
EBAY_TOKEN_STORE_URL=
EBAY_TOKEN_STORE_TOKEN=

CJ_API_KEY=
CJ_ACCESS_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/google-drive/oauth/callback
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_TOKEN_STORE_URL=
GOOGLE_DRIVE_TOKEN_STORE_TOKEN=

GOOGLE_SHEETS_SYNC_URL=
GOOGLE_SHEETS_SYNC_TOKEN=
GOOGLE_SHEETS_SYNC_STORE_URL=
GOOGLE_SHEETS_SYNC_STORE_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Jarvis File Manager V1: standardmäßig AUS. Erst nach Migration + Smoke Test bewusst auf true setzen.
# Bei false oder fehlendem Wert lädt Jarvis weiterhin ausschließlich die versionierten brain/*.md aus dem Repository.
JARVIS_FILE_STORE_ENABLED=false
UPSTASH_BACKUP_URL=
UPSTASH_BACKUP_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

ELYON_AGENT_RUNTIME_STORE_URL=
ELYON_AGENT_RUNTIME_STORE_TOKEN=

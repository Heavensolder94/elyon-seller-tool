{
  "name": "elyon-project-navigator-desktop",
  "productName": "Elyon Project Navigator",
  "version": "3.0.0",
  "description": "Lokale Windows-App zur Verwaltung der Elyon-Chats, Aufgaben, Dokumente und Bridge-Updates.",
  "main": "main.js",
  "author": "Raoul Mailvahanam",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "de.elyon.projectnavigator",
    "productName": "Elyon Project Navigator",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge-server.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elyon Project Navigator",
      "artifactName": "Elyon-Project-Navigator-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Elyon-Project-Navigator-Portable-${version}-${arch}.${ext}"
    }
  }
}
